metrics = []
{% for m in config.training.metrics %}
{% set params = m.params %}
{% if m.name == "Accuracy" %}
{% if params %}
metrics.append(torchmetrics.Accuracy(**{{ params }}))
{% else %}
metrics.append(torchmetrics.Accuracy())
{% endif %}
{% elif m.name == "F1Score" %}
{% if params %}
metrics.append(torchmetrics.F1Score(**{{ params }}))
{% else %}
metrics.append(torchmetrics.F1Score())
{% endif %}
{% elif m.name == "Recall" %}
{% if params %}
metrics.append(torchmetrics.Recall(**{{ params }}))
{% else %}
metrics.append(torchmetrics.Recall())
{% endif %}
{% elif m.name == "MeanAbsoluteError" %}
{% if params %}
metrics.append(torchmetrics.MeanAbsoluteError(**{{ params }}))
{% else %}
metrics.append(torchmetrics.MeanAbsoluteError())
{% endif %}
{% else %}
{% if m.name in METRIC_REGISTRY %}
{% if params %}
metrics.append(METRIC_REGISTRY["{{ m.name }}"](**{{ params }}))
{% else %}
metrics.append(METRIC_REGISTRY["{{ m.name }}"]())
{% endif %}
{% else %}
print("Unsupported metric: {{ m.name }}")
{% endif %}
{% endif %}
{% endfor %}