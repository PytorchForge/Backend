{
  "data": {
    "data": {
      "task_type": "ml",
      "main_task": "image",
      "sub_task": "classification",
      "data_format": "imagefolder",
      "data_type": "file"
    },
    "dataloading": "image_classification_loader",
    "preprocessing": [
      {
        "name": "RandomCrop",
        "params": {
          "size": [224, 224]
        }
      }
    ],
    "model": {
      "use_pretrained": false,
      "pretrained": {
        "name": "ResNet50",
        "params": {
          "pretrained": true
        }
      },
      "layers": [
        {
          "type": "Linear",
          "params": {
            "in_features": 512,
            "out_features": 10
          }
        }
      ]
    },
    "training": {
      "batch_size": 32,
      "learning_rate": 0.001,
      "epochs": 10,
      "weight_decay": 0.0001,
      "optimizer": {
        "name": "Adam",
        "params": {
          "lr": 0.001
        }
      },
      "scheduler": {
        "name": "StepLR",
        "params": {
          "step_size": 5,
          "gamma": 0.5
        }
      },
      "loss": {
        "name": "CrossEntropyLoss",
        "params": {}
      },
      "metrics": [
        {
          "name": "Accuracy",
          "params": {
            "average": "macro"
          }
        }
      ],
      "early_stopping": {
        "enabled": true,
        "params": {
          "patience": 5
        }
      },
      "monitoring": ["use_tensorboard"]
    }
  }

}
