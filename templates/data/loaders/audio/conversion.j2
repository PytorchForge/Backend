# Voice Conversion Dataset
import os
import torchaudio
from torch.utils.data import Dataset

class {{ class_name }}(Dataset):
    def __init__(self, source_dir, target_dir, transform=None):
        self.source_dir = source_dir
        self.target_dir = target_dir
        self.transform = transform
        self.pairs = self._load_pairs()

    def _load_pairs(self):
        files = os.listdir(self.source_dir)
        return [(os.path.join(self.source_dir, f), os.path.join(self.target_dir, f)) for f in files if os.path.exists(os.path.join(self.target_dir, f))]

    def __getitem__(self, index):
        src_path, tgt_path = self.pairs[index]
        src_wave, _ = torchaudio.load(src_path)
        tgt_wave, _ = torchaudio.load(tgt_path)
        if self.transform:
            src_wave = self.transform(src_wave)
            tgt_wave = self.transform(tgt_wave)
        return src_wave, tgt_wave

    def __len__(self):
        return len(self.pairs)
