# Text Generation Dataset
import pandas as pd
from torch.utils.data import Dataset

class {{ class_name }}(Dataset):
    def __init__(self, csv_path, tokenizer=None, prompt_col='prompt', target_col='output', max_length=256):
        self.data = pd.read_csv(csv_path)
        self.tokenizer = tokenizer
        self.prompt_col = prompt_col
        self.target_col = target_col
        self.max_length = max_length

    def __getitem__(self, index):
        prompt = self.data.loc[index, self.prompt_col]
        target = self.data.loc[index, self.target_col]
        if self.tokenizer:
            enc = self.tokenizer(prompt, truncation=True, padding='max_length', max_length=self.max_length, return_tensors='pt')
            label_enc = self.tokenizer(target, truncation=True, padding='max_length', max_length=self.max_length, return_tensors='pt')
            return {
                'input_ids': enc['input_ids'].squeeze(),
                'attention_mask': enc['attention_mask'].squeeze(),
                'labels': label_enc['input_ids'].squeeze()
            }
        return prompt, target

    def __len__(self):
        return len(self.data)
