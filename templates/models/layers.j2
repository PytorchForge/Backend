{# Linear #}
{% if layer_type == 'Linear' %}
    nn.Linear({{ in_features }}, {{ out_features }}, bias={{ bias | default(true) }})
{% elif layer_type == 'Bilinear' %}
    nn.Bilinear({{ in1_features }}, {{ in2_features }}, {{ out_features }}, bias={{ bias | default(true) }})
{% elif layer_type == 'Conv1d' %}
    nn.Conv1d(
        {{ in_channels }}, {{ out_channels }}, {{ kernel_size }},
        stride={{ stride | default(1) }}, padding={{ padding | default(0) }}, dilation={{ dilation | default(1) }},
        groups={{ groups | default(1) }}, bias={{ bias | default(true) }}, padding_mode='{{ padding_mode | default("zeros") }}'
    )
{% elif layer_type == 'Conv2d' %}
    nn.Conv2d(
        {{ in_channels }}, {{ out_channels }}, {{ kernel_size }},
        stride={{ stride }}, padding={{ padding | default(0) }}, dilation={{ dilation | default(1) }},
        groups={{ groups | default(1) }}, bias={{ bias | default(true) }}, padding_mode='{{ padding_mode | default("zeros") }}'
    )
{% elif layer_type == 'Conv3d' %}
    nn.Conv3d(
        {{ in_channels }}, {{ out_channels }}, {{ kernel_size }},
        stride={{ stride | default(1) }}, padding={{ padding | default(0) }}, dilation={{ dilation | default(1) }},
        groups={{ groups | default(1) }}, bias={{ bias | default(true) }}, padding_mode='{{ padding_mode | default("zeros") }}'
    )
{% elif layer_type == 'ConvTranspose1d' %}
    nn.ConvTranspose1d(
        {{ in_channels }}, {{ out_channels }}, {{ kernel_size }},
        stride={{ stride | default(1) }}, padding={{ padding | default(0) }},
        output_padding={{ output_padding | default(0) }}, bias={{ bias | default(true) }}
    )
{% elif layer_type == 'ConvTranspose2d' %}
    nn.ConvTranspose2d(
        {{ in_channels }}, {{ out_channels }}, {{ kernel_size }},
        stride={{ stride | default(1) }}, padding={{ padding | default(0) }},
        output_padding={{ output_padding | default(0) }}, bias={{ bias | default(true) }}
    )
{% elif layer_type == 'ConvTranspose3d' %}
    nn.ConvTranspose3d(
        {{ in_channels }}, {{ out_channels }}, {{ kernel_size }},
        stride={{ stride | default(1) }}, padding={{ padding | default(0) }},
        output_padding={{ output_padding | default(0) }}, bias={{ bias | default(true) }}
    )
{% elif layer_type == 'MaxPool1d' %}
    nn.MaxPool1d(
        {{ kernel_size }}, stride={{ stride | default(kernel_size) }},
        padding={{ padding | default(0) }}, dilation={{ dilation | default(1) }}, ceil_mode={{ ceil_mode | default(false) }}
    )
{% elif layer_type == 'MaxPool2d' %}
    nn.MaxPool2d(
        {{ kernel_size }}, stride={{ stride | default(kernel_size) }},
        padding={{ padding | default(0) }}, dilation={{ dilation | default(1) }}, ceil_mode={{ ceil_mode | default(false) }}
    )
{% elif layer_type == 'MaxPool3d' %}
    nn.MaxPool3d(
        {{ kernel_size }}, stride={{ stride | default(kernel_size) }},
        padding={{ padding | default(0) }}, dilation={{ dilation | default(1) }}, ceil_mode={{ ceil_mode | default(false) }}
    )
{% elif layer_type == 'AvgPool1d' %}
    nn.AvgPool1d(
        {{ kernel_size }}, stride={{ stride | default(kernel_size) }},
        padding={{ padding | default(0) }}, ceil_mode={{ ceil_mode | default(false) }},
        count_include_pad={{ count_include_pad | default(true) }}
    )
{% elif layer_type == 'AvgPool2d' %}
    nn.AvgPool2d(
        {{ kernel_size }}, stride={{ stride | default(kernel_size) }},
        padding={{ padding | default(0) }}, ceil_mode={{ ceil_mode | default(false) }},
        count_include_pad={{ count_include_pad | default(true) }}
    )
{% elif layer_type == 'AvgPool3d' %}
    nn.AvgPool3d(
        {{ kernel_size }}, stride={{ stride | default(kernel_size) }},
        padding={{ padding | default(0) }}, ceil_mode={{ ceil_mode | default(false) }},
        count_include_pad={{ count_include_pad | default(true) }}
    )
{% elif layer_type == 'BatchNorm1d' %}
    nn.BatchNorm1d(
        {{ num_features }}, eps={{ eps | default(1e-5) }}, momentum={{ momentum | default(0.1) }},
        affine={{ affine | default(true) }}, track_running_stats={{ track_running_stats | default(true) }}
    )
{% elif layer_type == 'BatchNorm2d' %}
    nn.BatchNorm2d(
        {{ num_features }}, eps={{ eps | default(1e-5) }}, momentum={{ momentum | default(0.1) }},
        affine={{ affine | default(true) }}, track_running_stats={{ track_running_stats | default(true) }}
    )
{% elif layer_type == 'BatchNorm3d' %}
    nn.BatchNorm3d(
        {{ num_features }}, eps={{ eps | default(1e-5) }}, momentum={{ momentum | default(0.1) }},
        affine={{ affine | default(true) }}, track_running_stats={{ track_running_stats | default(true) }}
    )
{% elif layer_type == 'LayerNorm' %}
    nn.LayerNorm(
        {{ normalized_shape }}, eps={{ eps | default(1e-5) }}, elementwise_affine={{ elementwise_affine | default(true) }}
    )
{% elif layer_type == 'Transformer' %}
    nn.Transformer(
        d_model={{ d_model | default(512) }}, nhead={{ nhead | default(8) }},
        num_encoder_layers={{ num_encoder_layers | default(6) }},
        num_decoder_layers={{ num_decoder_layers | default(6) }},
        dim_feedforward={{ dim_feedforward | default(2048) }}, dropout={{ dropout | default(0.1) }},
        activation='{{ activation | default("relu") }}'
    )
{% elif layer_type == 'MultiheadAttention' %}
    nn.MultiheadAttention(
        {{ embed_dim }}, {{ num_heads }},
        dropout={{ dropout | default(0.0) }}, bias={{ bias | default(true) }}, add_bias_kv={{ add_bias_kv | default(false) }}
    )
{% elif layer_type == 'Dropout' %}
    nn.Dropout(p={{ p | default(0.5) }}, inplace={{ inplace | default(false) }})
{% elif layer_type == 'Dropout1d' %}
    nn.Dropout1d(p={{ p | default(0.5) }}, inplace={{ inplace | default(false) }})
{% elif layer_type == 'Dropout2d' %}
    nn.Dropout2d(p={{ p | default(0.5) }}, inplace={{ inplace | default(false) }})
{% elif layer_type == 'Dropout3d' %}
    nn.Dropout3d(p={{ p | default(0.5) }}, inplace={{ inplace | default(false) }})
{% elif layer_type == 'Embedding' %}
    nn.Embedding(
        {{ num_embeddings }}, {{ embedding_dim }},
        padding_idx={{ padding_idx | default('None') }}, max_norm={{ max_norm | default('None') }}, sparse={{ sparse | default(false) }}
    )
{% elif layer_type == 'PixelShuffle' %}
    nn.PixelShuffle(upscale_factor={{ upscale_factor }})
{% elif layer_type == 'Upsample' %}
    nn.Upsample(size={{ size }}, scale_factor={{ scale_factor | default('None') }}, mode='{{ mode | default("nearest") }}')
{% elif layer_type == 'LSTM' %}
    nn.LSTM(
        input_size={{ input_size }}, hidden_size={{ hidden_size }},
        num_layers={{ num_layers | default(1) }}, batch_first={{ batch_first | default(false) }},
        bidirectional={{ bidirectional | default(false) }}
    )
{% elif layer_type == 'Flatten' %}
    nn.Flatten(start_dim={{ start_dim | default(1) }}, end_dim={{ end_dim | default(-1) }})
{% elif layer_type == 'Unfold' %}
    nn.Unfold(
        kernel_size={{ kernel_size }}, stride={{ stride | default(1) }},
        padding={{ padding | default(0) }}, dilation={{ dilation | default(1) }}
    )
{% endif %}
