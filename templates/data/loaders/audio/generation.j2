# Audio Generation Dataset (e.g., Text-to-Speech)
import os
import pandas as pd
import torchaudio
from torch.utils.data import Dataset

class {{ class_name }}(Dataset):
    def __init__(self, csv_path, text_column='text', audio_column='audio_path', transform=None):
        self.data = pd.read_csv(csv_path)
        self.text_column = text_column
        self.audio_column = audio_column
        self.transform = transform

    def __getitem__(self, index):
        row = self.data.iloc[index]
        text = row[self.text_column]
        waveform, sample_rate = torchaudio.load(row[self.audio_column])
        if self.transform:
            waveform = self.transform(waveform)
        return text, waveform

    def __len__(self):
        return len(self.data)
