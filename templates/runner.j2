

def main():
    with open("config.json") as f:
        config = json.load(f)

    set_seed(config)
    device = get_device(config)

    root = config["data"].get("root", ".")
    batch_size = config["training"]["batch_size"]
    
    train_loader = get_loader(root=root, batch_size=batch_size, split="train")
    val_loader = get_loader(root=root, batch_size=batch_size, split="val")

    {% if config.model.use_pretrained %}
    model = models.{{ config.model.pretrained.name }}(pretrained=True)
    {% else %}
    model = CustomModel(config)
    {% endif %}
    model.to(device)

    criterion = get_criterion(config)
    optimizer = get_optimizer(model, config)
    metrics = []
    {% for m in config.training.metrics %}
    {% set params = m.params %}
    {% if m.name == "Accuracy" %}
    {% if params %}
    metrics.append(torchmetrics.Accuracy(**{{ params }}))
    {% else %}
    metrics.append(torchmetrics.Accuracy())
    {% endif %}
    {% elif m.name == "F1Score" %}
    {% if params %}
    metrics.append(torchmetrics.F1Score(**{{ params }}))
    {% else %}
    metrics.append(torchmetrics.F1Score())
    {% endif %}
    {% elif m.name == "Recall" %}
    {% if params %}
    metrics.append(torchmetrics.Recall(**{{ params }}))
    {% else %}
    metrics.append(torchmetrics.Recall())
    {% endif %}
    {% elif m.name == "MeanAbsoluteError" %}
    {% if params %}
    metrics.append(torchmetrics.MeanAbsoluteError(**{{ params }}))
    {% else %}
    metrics.append(torchmetrics.MeanAbsoluteError())
    {% endif %}
    {% else %}
    {% if m.name in METRIC_REGISTRY %}
    {% if params %}
    metrics.append(METRIC_REGISTRY["{{ m.name }}"](**{{ params }}))
    {% else %}
    metrics.append(METRIC_REGISTRY["{{ m.name }}"]())
    {% endif %}
    {% else %}
    print("Unsupported metric: {{ m.name }}")
    {% endif %}
    {% endif %}
    {% endfor %}

    epochs = config["training"]["epochs"]

    history = {
        "epochs": epochs,
        "training": []
    }

    for epoch in range(epochs):
        train_loss, train_acc = train_one_epoch(
            model, train_loader, criterion, optimizer, device
        )
        val_loss, val_acc = evaluate(model, val_loader, criterion, device)

        epoch_log = {
            "epoch": epoch + 1,
            "train_loss": train_loss,
            "train_acc": train_acc,
            "val_loss": val_loss,
            "val_acc": val_acc
        }

        history["training"].append(epoch_log)

        print(
            f"Epoch {epoch + 1}/{epochs}: "
            f"Train Loss={train_loss:.4f}, Train Acc={train_acc:.4f}, "
            f"Val Loss={val_loss:.4f}, Val Acc={val_acc:.4f}"
        )

    Path("results.json").write_text(json.dumps(history, indent=4))

    print("Training completed. Results are saved in 'results.json'.")

if __name__ == "__main__":
    main()