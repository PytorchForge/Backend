# Summarisation Dataset
import pandas as pd
from torch.utils.data import Dataset

class {{ class_name }}(Dataset):
    def __init__(self, csv_path, article_col='article', summary_col='summary', tokenizer=None, max_length=256):
        self.data = pd.read_csv(csv_path)
        self.tokenizer = tokenizer
        self.article_col = article_col
        self.summary_col = summary_col
        self.max_length = max_length

    def __getitem__(self, index):
        article = self.data.loc[index, self.article_col]
        summary = self.data.loc[index, self.summary_col]
        if self.tokenizer:
            input_enc = self.tokenizer(article, truncation=True, padding='max_length', max_length=self.max_length, return_tensors='pt')
            label_enc = self.tokenizer(summary, truncation=True, padding='max_length', max_length=self.max_length, return_tensors='pt')
            return {
                'input_ids': input_enc['input_ids'].squeeze(),
                'attention_mask': input_enc['attention_mask'].squeeze(),
                'labels': label_enc['input_ids'].squeeze()
            }
        return article, summary

    def __len__(self):
        return len(self.data)
