
{% if model_type == 'glove' %}
GloVe(
    dim={{ dim }},
    name='{{ name }}'
)
{% elif model_type == 'fasttext' %}
FastText(
    language='{{ language }}'
)
{% elif model_type == 'transformer' %}
Transformer(
    d_model={{ d_model }},
    nhead={{ nhead }},
    num_encoder_layers={{ num_encoder_layers }},
    num_decoder_layers={{ num_decoder_layers }}
)
{% elif model_type == 'xlmroberta' %}
XLMRoberta(
    num_classes={{ num_classes }},
    dropout={{ dropout }},
    pooler_type='{{ pooler_type }}'
)
{% endif %}
